{
  "name": "lwpdfreader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "wasm:build": "sh scripts/build-wasm.sh",
    "test": "vitest run",
    "test:browser": "playwright test",
    "fixtures": "node scripts/fixtures.mjs",
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "benchmark:core": "node scripts/benchmark-core.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:heavy": "node scripts/heavy-fixture.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "idb": "^8.0.4",
    "pdfjs-dist": "^6.5.438",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.8",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^3.5.2",
    "sharp": "^0.34.5",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
